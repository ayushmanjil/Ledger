# Copy this file to .env and fill in the values from your Firebase project.
#
# Firebase Console → Project settings (gear icon) → General tab →
# "Your apps" → Web app → SDK setup and configuration → Config.
#
# These are safe to expose in a client bundle — Firebase's client config
# is not a secret; access is controlled by firestore.rules, not by hiding
# these values. Still, don't commit your actual .env file.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id